module top (
    input  wire        CLOCK_50,
    output reg  [7:0]  LEDR
);

    // === Clock e Rest ===
    wire clk = CLOCK_50;
    wire reset = 1'b0;      // Implemente a lÃ³gica para reiniciar o estado da comunicaÃ§Ã£o

    // === Sinais Avalon-MM para a JTAG UART ===
    wire        jtag_uart_cs         = 1'b1;  // Sempre ativo
    wire        jtag_uart_waitrequest;        // Indica pedido em processamento
    wire        jtag_uart_addr       = 1'b0;  // 0 = data, 1 = control
    reg         jtag_uart_read;               // Indica operaÃ§Ã£o de leitura
    wire [31:0] jtag_uart_readdata;
    reg         jtag_uart_write;              // Indica operaÃ§Ã£o de escrita
    reg  [31:0] jtag_uart_writedata;

    // === UART Leitura ===
    wire [7:0]  uart_rx_data     = jtag_uart_readdata[7:0];
    wire        uart_rx_valid    = jtag_uart_readdata[15];     // Sinal de dados vÃ¡lidos
    wire [15:0] uart_rx_avail    = jtag_uart_readdata[31:16];  // Quantos dados estÃ£o disponÃ­veis no buffer

    // === UART Escrita ===
    wire        data_to_write = 1'b0;  // Implemente a lÃ³gica para indicar que hÃ¡ dados para escrever

    // === Avalon-MM Controle de Leitura e Escrita ===
    always @(posedge clk) begin
        if (reset) begin
            jtag_uart_read      <= 1'b0;
            jtag_uart_write     <= 1'b0;
            jtag_uart_writedata <= 32'd0;
            LEDR[7:0]           <= 8'd0;
        end else begin
            if (data_to_write) begin
                // === Escrita ===
                if (!jtag_uart_write) begin
                    jtag_uart_write     <= 1'b1;
                    jtag_uart_writedata <= {24'd0, 8'h41};

                    // Implemente sua lÃ³gica para criar o pacote de dados a ser escrito
                end else if (!jtag_uart_waitrequest) begin
                    jtag_uart_write     <= 1'b0;
                end
            end else begin
                // === Leitura ===
                if (!jtag_uart_read) begin
                    jtag_uart_read <= 1'b1;
                end else if (!jtag_uart_waitrequest) begin
                    jtag_uart_read <= 1'b0;
                    if (uart_rx_valid) begin
                        LEDR[7:0] <= uart_rx_data;  // Mostrar o byte recebido nos leds
                    end
                end
            end
        end
    end

    // === Instancie o mÃ³dulo JTAG UART seguindo o arquivo _inst gerado ===
    jtag_uart jtag_uart_inst (
        .clk_clk          (clk),
        .reset_reset_n    (!reset),
        .av_chipselect    (jtag_uart_cs),
        .av_address       (jtag_uart_addr),
        .av_read_n        (!jtag_uart_read),
        .av_readdata      (jtag_uart_readdata),
        .av_write_n       (!jtag_uart_write),
        .av_writedata     (jtag_uart_writedata),
        .av_waitrequest   (jtag_uart_waitrequest),
        .irq_irq          ()
    );

endmodule